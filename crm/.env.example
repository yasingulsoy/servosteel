# CRM ortam değişkenleri — gerçek değerler .env.local'da (git'e girmez) ya da Dokploy'da.

# Sitenin kullandığı veritabanının AYNISI. CRM tabloları crm_ önekli.
DATABASE_URL=
# Aynı sunucudaki Postgres TLS konuşmuyorsa: off
DATABASE_SSL=

# YALNIZ yerel geliştirmede (next dev): 1 ise girişsiz "geliştirici" oturumu açılır.
# Canlıda (next start) NODE_ENV production olduğu için hiçbir etkisi yoktur.
CRM_GELISTIRME_GIRIS=
