# Servosteel — ortam değişkenleri örneği
#
# Bu dosya git'te DURUR ve yalnızca hangi değişkenlerin gerektiğini anlatır.
# GERÇEK DEĞERLER `.env.local` dosyasına yazılır ve git'e ASLA girmez
# (.gitignore'da `.env*` var, bu dosya `!.env.example` ile ayrık tutuluyor).
#
# Canlıda değerler Dokploy panelindeki Environment bölümünden verilir.

# --- Site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://servosteel.com.tr

# --- Form e-postası ---------------------------------------------------
# Talebin ASLI budur. Veritabanı yazımı bunun üstüne eklenen bir kopyadır;
# Postgres düşse bile talep firmaya ulaşmaya devam eder.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_BCC=

# --- Tanıtım e-postası (Panel → Hedef firmalar) ----------------------
# AYRI kutular — form bildirimlerinin gittiği SMTP_USER (website@) OLMAZ;
# aynı kutu girilirse o kutu kullanılmaz. Sunucu/port boşsa SMTP_HOST ve
# SMTP_PORT kullanılır. Yalnızca CANLIDA (Dokploy) doldurulur: .env.local
# canlı veritabanına bağlı, lokal panel gerçek e-posta gönderirdi.
#
# Birden çok kutu: 1. kutu OUTREACH_SMTP_USER, sonrakiler _2 … _9. Ek kutunun
# sunucusu/portu/görünen adı boşsa 1. kutununki (OUTREACH_SMTP_HOST_2,
# OUTREACH_SMTP_PORT_2, OUTREACH_FROM_NAME_2 ile ayrı verilebilir). Panel her
# gönderimde bugün en az göndermiş kutuyu seçer.
#
# Sınırlar kodda (src/lib/outreach-kurallar.ts):
#   kutu başına günde OUTREACH_DAILY_LIMIT (en çok 50; ısınma 1. hafta 10, 2. hafta 15)
#   alan adı başına günde OUTREACH_DOMAIN_DAILY_LIMIT (en çok 150; ısınma 20, 35)
#     — aynı alan adındaki kutuların TOPLAMI; itibar alan adına bağlı
#   aynı kutudan iki e-posta arası en az OUTREACH_INTERVAL_SEC (en az 60)
OUTREACH_SMTP_HOST=mail.servosteel.com.tr
OUTREACH_SMTP_PORT=465
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASS=
OUTREACH_SMTP_USER_2=
OUTREACH_SMTP_PASS_2=
OUTREACH_SMTP_USER_3=
OUTREACH_SMTP_PASS_3=
OUTREACH_SMTP_USER_4=
OUTREACH_SMTP_PASS_4=
OUTREACH_FROM_NAME=Servosteel Export
# Yanıtlar okunan kutuya gitsin (e-postalar Liza imzalı)
OUTREACH_REPLY_TO=
# İlk günler kendi Gmail adresi: kopyanın Spam'e düşüp düşmediği görülür.
OUTREACH_BCC=
OUTREACH_DAILY_LIMIT=20
OUTREACH_DOMAIN_DAILY_LIMIT=50
OUTREACH_INTERVAL_SEC=90

# --- Veritabanı (talep kaydı + yönetim paneli) ------------------------
# Dokploy'daki Postgres servisinin **Internal Connection URL**'i kullanılır;
# uygulama aynı sunucuda, aynı ağda çalışıyor. Dış port (25632) internete
# açıktır ve gerekmedikçe kullanılmaz.
#
#   postgres://servo_user:PAROLA@servosteel-servosteeldb-uqmygk:5432/servosteel
#
# Konteynerler arası bağlantı TLS kullanmaz:
DATABASE_URL=
DATABASE_SSL=off

# --- Yönetim paneli (/admin) ------------------------------------------
# Karmayı ve oturum anahtarını üretmek için:
#   node scripts/admin-parola.mjs "parolanız"
# Çıkan üç satırı buraya yapıştırın. Parolanın kendisi hiçbir yere yazılmaz.
#
# Üçünden biri eksikse panel TAMAMEN kapalıdır — varsayılan parola yoktur.
ADMIN_USER=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Arama motoru doğrulama -------------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
